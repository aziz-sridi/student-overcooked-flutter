# OpenRouter API key for server-side requests
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: choose an OpenRouter model
ASKAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: enable reasoning responses (true/false)
ASKAI_REASONING_ENABLED=false

# Optional: customize assistant tone
ASKAI_SYSTEM_PROMPT=You are a helpful study assistant for a student project workspace.

# Firebase Admin credentials (choose one)
# FIREBASE_SERVICE_ACCOUNT_JSON={...json...}
FIREBASE_SERVICE_ACCOUNT_FILE=
