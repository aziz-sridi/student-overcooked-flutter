rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectMember(project) {
      return isSignedIn() && request.auth.uid in project.data.memberUids;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || resource.data.inviteCode != null
      );

      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;

      allow update: if isSignedIn() && (
        isProjectMember(resource) ||
        (
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
          request.resource.data.memberLabels.size() == resource.data.memberLabels.size() + 1 &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'memberUids',
            'memberLabels'
          ])
        )
      );
    }

    match /projects/{projectId}/messages/{messageId} {
      allow read, create: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
    }

    match /projects/{projectId}/tasks/{taskId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
    }
  }
}
